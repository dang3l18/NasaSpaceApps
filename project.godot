; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Zyranth"
config/description="ZYRANTH: juego educativo de misiones espaciales (Junior Astronaut: Mission Trainer). Usa datos abiertos de NASA (DONKI, GIBS, LRO, CMR)."
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

FontSetup="*res://scripts/FontSetup.gd"
NASADataManager="*res://scripts/data/NASADataManager.gd"
DatasetManager="*res://scripts/data/DatasetManager.gd"
ScientificDataManager="*res://scripts/data/ScientificDataManager.gd"
EarthImageryManager="*res://scripts/data/EarthImageryManager.gd"
MissionManager="*res://scripts/missions/MissionManager.gd"
AchievementManager="*res://scripts/missions/AchievementManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
